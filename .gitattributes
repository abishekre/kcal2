# Auto detect text files and perform LF normalization
* text=auto

# Treat binary assets as binary: never apply EOL normalization or text diffs.
# (LF normalization on a mis-detected binary is what corrupted the PNG icons.)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
