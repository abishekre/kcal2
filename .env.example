VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Canonical app URL used as the redirect target for magic-link,
# email-confirmation, and password-reset emails. Set this to your deployed
# URL (e.g. https://yourapp.com) so those email links always point at
# production instead of wherever the request happened to be made. If unset,
# the app uses the current browser origin. This URL must ALSO be added to your
# Supabase project's Authentication → URL Configuration → Redirect URLs.
# VITE_SITE_URL=https://yourapp.com
